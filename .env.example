# Copy to .env and fill in real values.
# .env stays on this machine only — never commit it to git.

# OpenAI API key (get one at https://platform.openai.com/api-keys, starts with sk-)
OPENAI_API_KEY=sk-...

# Model used for grading (default gpt-4o — best image understanding; change as needed)
OPENAI_MODEL=gpt-4o

# Login passwords (minimum 12 characters each). App refuses to start without them.
GRADER_PASSWORD=change-me-to-something-long
ADMIN_PASSWORD=change-me-to-something-long-too

# Public demo account (optional). Leave empty to disable.
# When set, anyone with these credentials gets an isolated sandbox with
# strict rate limits — they cannot see your real classes or grades.
PUBLIC_USER=public
PUBLIC_PASSWORD=

# Public demo rate limits (per day). Only apply to the public role.
PUBLIC_MAX_RUBRIC_JOBS_PER_DAY=3
PUBLIC_MAX_GRADES_PER_DAY=20
PUBLIC_MAX_RETRIES_PER_DAY=10
# One photo per question for the demo account (token protection).
PUBLIC_MAX_RUBRIC_IMAGES=1
PUBLIC_MAX_GRADE_IMAGES=4
# Lifetime cap: total questions the demo account may ever create/fix
# via rubric generation + retries. 0 disables.
PUBLIC_MAX_QUESTIONS_LIFETIME=100
# Max tokens per day for the public role (0 = no per-role cap).
PUBLIC_DAILY_TOKEN_BUDGET=500000

# Optional: Postgres connection string. If unset, the app uses local SQLite (ai_grader.db).
# DATABASE_URL=postgresql://user:password@host/dbname
