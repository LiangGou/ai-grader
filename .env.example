# Copy to .env and fill in real values.
# .env stays on this machine only — never commit it to git.

# OpenAI API key (get one at https://platform.openai.com/api-keys, starts with sk-)
OPENAI_API_KEY=sk-...

# Model used for grading (default gpt-4o — best image understanding; change as needed)
OPENAI_MODEL=gpt-4o

# Login passwords (minimum 12 characters each). App refuses to start without them.
GRADER_PASSWORD=change-me-to-something-long
ADMIN_PASSWORD=change-me-to-something-long-too

# Optional: Postgres connection string. If unset, the app uses local SQLite (ai_grader.db).
# DATABASE_URL=postgresql://user:password@host/dbname
