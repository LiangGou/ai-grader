# Copy to .env and fill in real values. Note: .env stays on this machine only — never commit it to git.
# Get a key at https://platform.openai.com/api-keys (starts with sk-)
OPENAI_API_KEY=sk-...

# Model used for grading and rubric structuring (default gpt-4o — best image understanding; change as needed)
OPENAI_MODEL=gpt-4o
