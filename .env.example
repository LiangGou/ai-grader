# Copy to .env and fill in real values.
# .env stays on this machine only — never commit it to git.

# OpenAI API key (get one at https://platform.openai.com/api-keys, starts with sk-)
OPENAI_API_KEY=sk-...

# Model used for grading (default gpt-4o — best image understanding; change as needed)
OPENAI_MODEL=gpt-4o

# Model used for EVERY call made as the public demo role. Must stay a cheap
# non-reasoning model: gpt-4o or gpt-4o-mini. The app refuses to start with
# the public account enabled otherwise (an OPENAI_MODEL=o3 override must not
# give strangers reasoning-model spend).
PUBLIC_MODEL=gpt-4o

# Login passwords (minimum 12 characters each). App refuses to start without them.
GRADER_PASSWORD=change-me-to-something-long
ADMIN_PASSWORD=change-me-to-something-long-too

# Public demo account (optional). Leave PUBLIC_PASSWORD empty to disable.
# When set, anyone with these credentials gets an isolated sandbox with
# strict rate limits — they cannot see your real classes or grades.
# The public password may be short/simple (it's a shared demo login); the
# real protection is data isolation + rate limits, not password strength.
# It must still differ from GRADER_PASSWORD and ADMIN_PASSWORD.
PUBLIC_USER=public
PUBLIC_PASSWORD=

# Public demo rate limits (per day). Only apply to the public role.
PUBLIC_MAX_RUBRIC_JOBS_PER_DAY=3
PUBLIC_MAX_GRADES_PER_DAY=20
PUBLIC_MAX_RETRIES_PER_DAY=10
# One photo per question for the demo account (token protection).
PUBLIC_MAX_RUBRIC_IMAGES=1
PUBLIC_MAX_GRADE_IMAGES=4
# Lifetime cap: total questions the demo account may ever create/fix
# via rubric generation + retries. 0 disables.
PUBLIC_MAX_QUESTIONS_LIFETIME=100
# Max tokens per day for the public role. Enforced per API call, not just at
# route entry. Must be positive and at most half of DAILY_TOKEN_BUDGET when
# the public account is enabled.
PUBLIC_DAILY_TOKEN_BUDGET=500000
# Max input characters per request for the demo role (retry/regenerate text).
PUBLIC_MAX_TEXT_CHARS=4000
# Max stored reference/example photos per assignment for the demo role.
# PUBLIC_MAX_REFERENCE_IMAGES must stay below PUBLIC_MAX_GRADE_IMAGES.
PUBLIC_MAX_REFERENCE_IMAGES=3
PUBLIC_MAX_EXAMPLE_IMAGES=4
# Max stored rubric size (chars) per assignment for the demo role.
PUBLIC_MAX_RUBRIC_CHARS=20000
# Max classes / assignments the demo account may create (storage protection).
PUBLIC_MAX_CLASSES=10
PUBLIC_MAX_ASSIGNMENTS=20

# Optional: Postgres connection string. If unset, the app uses local SQLite (ai_grader.db).
# DATABASE_URL=postgresql://user:password@host/dbname
